---
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Announcements | Family Cabin PM</title>
    <style is:global>
      :root { font-family: Arial, sans-serif; color: #263b38; background: #e7ddd0; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main { width: min(100% - 2rem, 56rem); margin: 2rem auto; }
      a { color: #285447; }
      .topbar, .card { padding: 1.25rem; background: #fff; border-radius: 0.65rem; }
      .topbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
      h1 { margin: 0; }
      form { display: grid; gap: 1rem; margin: 1.5rem 0; }
      label { display: grid; gap: 0.4rem; font-weight: bold; }
      input, textarea, button { padding: 0.7rem; border: 1px solid #9db8b0; border-radius: 0.35rem; font: inherit; }
      textarea { min-height: 7rem; resize: vertical; }
      .checkbox { display: flex; grid-template-columns: auto 1fr; align-items: center; gap: 0.5rem; }
      button { color: #fff; background: #508879; border: 0; font-weight: bold; cursor: pointer; }
      .announcement-list { display: grid; gap: 1rem; }
      .announcement-card.urgent { border-left: 6px solid #c23d3d; }
      .author { color: #55706a; font-size: 0.9rem; }
      .actions { margin-top: 1rem; }
      .remove { color: #6b3b13; background: #f2c078; }
      .confirm-dialog { max-width: 24rem; padding: 0; border: 0; border-radius: 0.65rem; }
      .confirm-dialog::backdrop { background: rgb(38 59 56 / 45%); }
      .confirm-card { padding: 1.5rem; }
      .confirm-card h2 { margin-top: 0; }
      .confirm-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; }
      .confirm-actions .cancel { color: #285447; background: #dceee8; }
      .confirm-actions .remove-confirm { background: #a33d3d; }
      .edit { margin-right: 0.75rem; }
      .edit-form { display: grid; gap: 0.75rem; margin-top: 1rem; }
      .edit-form[hidden] { display: none; }
      .message { min-height: 1.25rem; color: #8d2929; }
      .success { color: #285447; }
    </style>
  </head>
  <body>
    <main>
      <header class="topbar">
        <h1>Announcements</h1>
        <a href="/">Back to dashboard</a>
      </header>

      <form id="announcement-form" class="card">
        <h2>Post an announcement</h2>
        <label for="title">Title <input id="title" name="title" required /></label>
        <label for="body">Body <textarea id="body" name="body" required></textarea></label>
        <label class="checkbox" for="isUrgent">
          <input id="isUrgent" name="isUrgent" type="checkbox" />
          Mark as urgent
        </label>
        <button type="submit">Publish announcement</button>
        <p id="form-message" class="message" role="status" aria-live="polite"></p>
      </form>

      <section aria-labelledby="recent-announcements">
        <h2 id="recent-announcements">Recent announcements</h2>
        <div id="announcement-list" class="announcement-list"></div>
      </section>
    </main>

    <script define:vars={{ apiUrl }}>
      const form = document.querySelector("#announcement-form");
      const message = document.querySelector("#form-message");
      const announcementList = document.querySelector("#announcement-list");

      async function loadAnnouncements() {
        const response = await fetch(`${apiUrl}/api/v1/announcements`, {
          credentials: "include"
        });
        if (response.status === 401) {
          window.location.href = "/login";
          return;
        }
        if (!response.ok) throw new Error("Unable to load announcements");
        const result = await response.json();
        renderAnnouncements(result.announcements);
      }

      async function getCurrentUser() {
        const response = await fetch(`${apiUrl}/api/v1/auth/me`, {
          credentials: "include"
        });
        if (!response.ok) return null;
        return (await response.json()).user;
      }

      async function renderAnnouncements(announcements) {
        if (!(announcementList instanceof HTMLElement)) return;
        const currentUser = await getCurrentUser();
        announcementList.replaceChildren();

        for (const announcement of announcements) {
          const card = document.createElement("article");
          card.className = `card announcement-card${announcement.isUrgent ? " urgent" : ""}`;

          const title = document.createElement("h3");
          title.textContent = announcement.isUrgent ? `Urgent: ${announcement.title}` : announcement.title;
          const body = document.createElement("p");
          body.textContent = announcement.body;
          const author = document.createElement("p");
          author.className = "author";
          author.textContent = `Published by ${announcement.authorId?.name ?? "Family member"}`;
          card.append(title, body, author);

          if (currentUser && announcement.authorId?._id === currentUser.id) {
            const actions = document.createElement("div");
            actions.className = "actions";
            const editButton = document.createElement("button");
            editButton.type = "button";
            editButton.className = "edit";
            editButton.textContent = "Edit";

            const editForm = document.createElement("form");
            editForm.className = "edit-form";
            editForm.hidden = true;
            editForm.innerHTML = `
              <label>Title <input name="title" required /></label>
              <label>Body <textarea name="body" required></textarea></label>
              <label><input name="isUrgent" type="checkbox" /> Mark as urgent</label>
              <button type="submit">Save changes</button>
            `;
            const titleInput = editForm.querySelector('input[name="title"]');
            const bodyInput = editForm.querySelector('textarea[name="body"]');
            const urgentInput = editForm.querySelector('input[name="isUrgent"]');
            if (titleInput instanceof HTMLInputElement) titleInput.value = announcement.title;
            if (bodyInput instanceof HTMLTextAreaElement) bodyInput.value = announcement.body;
            if (urgentInput instanceof HTMLInputElement) urgentInput.checked = announcement.isUrgent;

            editButton.addEventListener("click", () => {
              editForm.hidden = !editForm.hidden;
              editButton.textContent = editForm.hidden ? "Edit" : "Cancel edit";
            });

            editForm.addEventListener("submit", async (event) => {
              event.preventDefault();
              const data = new FormData(editForm);
              const response = await fetch(
                `${apiUrl}/api/v1/announcements/${announcement._id}`,
                {
                  method: "PATCH",
                  credentials: "include",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    title: data.get("title"),
                    body: data.get("body"),
                    isUrgent: data.has("isUrgent")
                  })
                }
              );
              if (response.ok) await loadAnnouncements();
            });

            const removeButton = document.createElement("button");
            removeButton.type = "button";
            removeButton.className = "remove";
            removeButton.textContent = "Remove";
            removeButton.addEventListener("click", async () => {
              const dialog = document.createElement("dialog");
              dialog.className = "confirm-dialog";
              dialog.innerHTML = `
                <div class="confirm-card">
                  <h2>Remove this announcement?</h2>
                  <p>This announcement will be removed from the family group.</p>
                  <div class="confirm-actions">
                    <button type="button" class="cancel">Keep announcement</button>
                    <button type="button" class="remove-confirm">Remove announcement</button>
                  </div>
                </div>
              `;

              const close = (confirmed) => {
                dialog.close();
                dialog.remove();
                if (confirmed) removeAnnouncement();
              };
              const removeAnnouncement = async () => {
                const removeResponse = await fetch(
                  `${apiUrl}/api/v1/announcements/${announcement._id}`,
                  { method: "DELETE", credentials: "include" }
                );
                if (removeResponse.ok) await loadAnnouncements();
              };

              dialog.querySelector(".cancel")?.addEventListener("click", () => close(false));
              dialog.querySelector(".remove-confirm")?.addEventListener("click", () => close(true));
              dialog.addEventListener("cancel", (event) => {
                event.preventDefault();
                close(false);
              });

              document.body.append(dialog);
              dialog.showModal();
            });
            actions.append(editButton, removeButton);
            card.append(actions, editForm);
          }

          announcementList.append(card);
        }
      }

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !(message instanceof HTMLElement)) return;
        const data = new FormData(form);
        message.className = "message";
        message.textContent = "Publishing announcement...";

        const response = await fetch(`${apiUrl}/api/v1/announcements`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            title: data.get("title"),
            body: data.get("body"),
            isUrgent: data.has("isUrgent")
          })
        });
        const result = await response.json();

        if (!response.ok) {
          message.textContent = result.details?.join(". ") ?? result.error ?? "Unable to publish.";
          return;
        }

        form.reset();
        message.className = "message success";
        message.textContent = "Announcement published.";
        await loadAnnouncements();
      });

      loadAnnouncements().catch(() => {
        if (message instanceof HTMLElement) message.textContent = "Unable to load announcements.";
      });
    </script>
  </body>
</html>
